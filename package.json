{
  "name": "tapnote",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tapnote \"vitest run -c vitest.rules.config.mts\"",
    "sync:android": "ng build && cap sync android"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "dexie": "^4.4.6",
    "firebase": "^13.1.0",
    "minisearch": "^7.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
